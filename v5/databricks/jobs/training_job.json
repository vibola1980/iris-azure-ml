{
  "name": "iris-automl-training",
  "description": "End-to-end Iris model training pipeline: ingest data, run AutoML, export model to Blob Storage",
  "tags": {
    "project": "iris-ml-v5",
    "team": "ml-engineering"
  },
  "tasks": [
    {
      "task_key": "data_ingestion",
      "description": "Load Iris dataset into Delta Table",
      "notebook_task": {
        "notebook_path": "/Repos/iris-ml/v5/databricks/notebooks/01_data_ingestion"
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_D4s_v3",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      }
    },
    {
      "task_key": "automl_training",
      "description": "Run AutoML classification and register best model",
      "depends_on": [
        { "task_key": "data_ingestion" }
      ],
      "notebook_task": {
        "notebook_path": "/Repos/iris-ml/v5/databricks/notebooks/02_automl_training"
      },
      "new_cluster": {
        "spark_version": "14.3.x-ml-scala2.12",
        "node_type_id": "Standard_D4s_v3",
        "num_workers": 1,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      }
    },
    {
      "task_key": "model_export",
      "description": "Export best model as pkl to Azure Blob Storage",
      "depends_on": [
        { "task_key": "automl_training" }
      ],
      "notebook_task": {
        "notebook_path": "/Repos/iris-ml/v5/databricks/notebooks/03_model_export",
        "base_parameters": {
          "storage_account": "{{storage_account_name}}",
          "storage_container": "models"
        }
      },
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_D4s_v3",
        "num_workers": 0,
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        }
      }
    }
  ],
  "schedule": null,
  "max_concurrent_runs": 1
}
