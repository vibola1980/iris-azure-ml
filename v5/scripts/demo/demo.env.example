# ============================================
# Demo Environment Variables
# ============================================
# Copy this file to .demo-env and fill in the values:
#   cp scripts/demo/demo.env.example .demo-env
#
# MANUAL: Campos que voce precisa preencher antes da demo.
# AUTO:   Campos preenchidos automaticamente por 01_provision.sh.
# ============================================

# --- [MANUAL] Preencha antes de rodar a demo ---

# Databricks workspace URL (ex: https://adb-1234567890.1.azuredatabricks.net)
# Obtenha via: terraform output databricks_workspace_url
DATABRICKS_HOST=https://adb-XXXXXXXXXXXX.XX.azuredatabricks.net

# Databricks personal access token
# Gere em: Databricks UI > Settings > Developer > Access tokens
DATABRICKS_TOKEN=dapi...

# Chave de API para autenticacao na API Gateway
# Valor livre, sera usado como X-API-Key header
API_KEY=demo-key-2025

# --- [AUTO] Preenchidos por 01_provision.sh (nao editar) ---
# ACR_LOGIN_SERVER=acririsdevXXXXXX.azurecr.io
# ACR_NAME=acririsdevXXXXXX
# STORAGE_ACCOUNT=stirisdevXXXXXX
# STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net'
# AKS_CLUSTER_NAME=aks-iris-dev
# RESOURCE_GROUP=rg-iris-dev
