# ============================================
# Demo Environment Variables
# ============================================
# Copy this file to .demo-env and fill in the values:
#   cp scripts/demo/demo.env.example .demo-env
#
# Databricks values are set manually (before demo).
# Azure values are filled automatically by 01_provision.sh.
# ============================================

# --- Pre-fill these before the demo ---
DATABRICKS_HOST=https://dbc-XXXX.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
API_KEY=demo-key-2025

# --- Filled automatically by 01_provision.sh ---
# ACR_LOGIN_SERVER=
# ACR_NAME=
# STORAGE_ACCOUNT=
# STORAGE_CONNECTION_STRING=
# AKS_CLUSTER_NAME=
# RESOURCE_GROUP=
